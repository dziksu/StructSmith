# Server
PORT=3000
HOST=0.0.0.0

# Database (SQLite file)
DATABASE_PATH=./data/architecture.db

# Auth: none | token
AUTH_MODE=none
APP_TOKEN=

# MCP
MCP_READ_ONLY=false

# In-app agent chat: available only through a localhost connection
AGENT_CHAT_ENABLED=true
AGENT_CHAT_DIR=./data/agent-chat

# Seed the example workspace on first boot
SEED_EXAMPLE=true
