{
  "$schema": "https://biomejs.dev/schemas/2.5.12/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": ["**", "!**/dist", "!**/node_modules", "!bun.lock", "!migrations"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      // Both rules describe patterns this editor cannot express: list rows
      // carry their own action buttons (nesting <button> is invalid HTML), and
      // the canvas is a drag-and-drop target rather than a click target. The
      // keyboard path for every element is the model tree.
      "a11y": {
        "useSemanticElements": "off",
        "noStaticElementInteractions": "off"
      },
      "style": {
        "noNonNullAssertion": "error",
        "useConst": "error"
      },
      "suspicious": {
        "noExplicitAny": "error"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "trailingCommas": "all",
      "semicolons": "always"
    }
  },
  "css": {
    // Tailwind v4 at-rules (@theme, @custom-variant, @apply).
    "parser": { "tailwindDirectives": true }
  },
  "assist": { "actions": { "source": { "organizeImports": "on" } } }
}
